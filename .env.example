# =============================================================================
# EARN & PAY — Environment Configuration Template
# Copy this file to `.env` for local development. Never commit `.env` to Git.
# =============================================================================

# Application Environment: development | testing | production
FLASK_ENV=development
FLASK_APP=wsgi.py

# Cryptographic Secret Key (Generate via: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=replace-with-a-64-char-cryptographically-random-hex-string

# PostgreSQL Database Connections (Psycopg 3 driver: postgresql+psycopg://)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/earn_and_pay_dev
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/earn_and_pay_test

# Session & Cookie Hardening
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME_MINUTES=120

# Upload Restrictions (Max 5 MB)
MAX_CONTENT_LENGTH=5242880
UPLOAD_FOLDER=instance/uploads

# Rate Limiting Storage
RATELIMIT_STORAGE_URI=memory://
RATELIMIT_ENABLED=true

# Initial Launch Area Metadata
LAUNCH_CITY=Bengaluru
LAUNCH_COUNTRY=India
DEFAULT_CURRENCY=INR
